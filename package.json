{
  "name": "solidsync-monorepo",
  "version": "0.4.5",
  "private": true,
  "author": "Mani E. Sohi",
  "description": "Shop-floor part filer: one headless server, many Electron clients, on a local network.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @solidsync/client",
    "server": "npm run dev --workspace solidsync",
    "build": "npm run build --workspace @solidsync/client",
    "build:server": "npm run build --workspace solidsync",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "bump": "node scripts/bump.mjs",
    "pack:win": "npm run pack:win --workspace @solidsync/client",
    "build:win": "npm run build:win --workspace @solidsync/client",
    "build:linux": "npm run build:linux --workspace @solidsync/client",
    "ship:all": "node scripts/ship.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
