{
  "name": "solidsync",
  "version": "0.2.0",
  "description": "Headless SolidSync shop server with a CLI: org DB, per-project git repos, REST API.",
  "type": "module",
  "bin": {
    "solidsync-server": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli.ts serve",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@solidsync/shared": "*",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/sql.js": "^1.4.11",
    "esbuild": "^0.25.0",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "sql.js": "^1.14.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
